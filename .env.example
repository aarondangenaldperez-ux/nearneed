# Copy this file to .env.local when a Supabase project is ready.
# The publishable key is browser-safe when database Row Level Security is correct.
# Never put a service-role or secret key in any NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Leave unset to keep new registration closed.
# Set this only when an adult project owner is ready to invite pilot participants.
NEED_PILOT_INVITE_CODE=
